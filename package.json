{
  "name": "agenttrace",
  "version": "0.1.0",
  "private": true,
  "description": "Visual debugger for AI and LLM pipelines",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/graph.test.ts test/executor.test.ts test/partial-executor.test.ts test/migrate.test.ts test/runs.repo.test.ts test/runs.service.test.ts",
    "db:migrate": "tsx src/config/migrate.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.11.13",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
